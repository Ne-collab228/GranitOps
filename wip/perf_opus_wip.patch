+func _tri_split(tag: String, at: Vector3, look: Vector3) -> void:
+	var p: Player = Game.player
+	var prims := func() -> float:
+		var s0 := 0.0
+		for i in 4:
+			p.hp = 100000.0
+			p.global_position = _test_hop(at)
+			_aim(p, look + Vector3(0, level.ground(look.x, look.z), 0))
+			await get_tree().process_frame
+			if i >= 2:
