+		return s0 / 2.0
+	var base: float = await prims.call()
+	var groups := {}
+	var stack: Array[Node] = [world]
+	while not stack.is_empty():
+		var n: Node = stack.pop_back()
+		for ch in n.get_children():
+			stack.append(ch)
+		if n is GeometryInstance3D and (n as GeometryInstance3D).visible:
+			var psc: Script = n.get_parent().get_script()
+			var key := String(n.name).rstrip("0123456789_@").left(20) + " <" + (psc.resource_path.get_file() if psc else String(n.get_parent().name).rstrip("0123456789_@").left(14)) + ">"
+			if String(n.name).begins_with("@"):
+				# безымянные: различаем по текстуре/шейдеру первого материала и режиму тени
+				var gi := n as GeometryInstance3D
+				var m0: Material = gi.material_override
+				var msh: Mesh = (gi as MeshInstance3D).mesh if gi is MeshInstance3D else ((gi as MultiMeshInstance3D).multimesh.mesh if gi is MultiMeshInstance3D and (gi as MultiMeshInstance3D).multimesh else null)
+				if m0 == null and msh and msh.get_surface_count() > 0:
+					m0 = msh.surface_get_material(0)
+				var tx := "?"
+				if m0 is BaseMaterial3D and (m0 as BaseMaterial3D).albedo_texture:
+					tx = (m0 as BaseMaterial3D).albedo_texture.resource_path.get_file().left(16)
+				elif m0 is ShaderMaterial:
+					tx = "sh:" + (m0 as ShaderMaterial).shader.resource_path.get_file().left(12)
+				key += " [%s%s]" % [tx, " тень" if gi.cast_shadow == GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY else ""]
+			if not groups.has(key):
+				groups[key] = []
+			(groups[key] as Array).append(n)
+	var res := []
+	for k in groups:
+		for g in groups[k]:
+			(g as GeometryInstance3D).visible = false
+		var v: float = await prims.call()
+		for g in groups[k]:
+			(g as GeometryInstance3D).visible = true
+		if base - v > 2000.0:
+			res.append([k, base - v, (groups[k] as Array).size()])
+	res.sort_custom(func(a, b): return a[1] > b[1])
+	var sh := level.sun.shadow_enabled
+	level.sun.shadow_enabled = false
+	var nos: float = await prims.call()
+	level.sun.shadow_enabled = sh
+	print("TRISPLIT %s: всего %dk, тени %dk" % [tag, int(base / 1000.0), int((base - nos) / 1000.0)])
+	for r in res.slice(0, 18):
+		print("  %-64s узлов=%4d  %6dk" % [r[0], r[2], int(r[1] / 1000.0)])
+
