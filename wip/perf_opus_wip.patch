+class_name Prof
+## Лёгкий профайлер скриптов: время крупных блоков (мкс) копится за окно замера.
+##
+## Работает всегда (пара вызовов Time.get_ticks_usec на блок — копейки), чтобы журнал с телефона показывал
+## виновника: Blackbox раз в 10 с пишет строку «скр: ии=.. поза=.. …» (среднее мс на кадр) и пики (мс за один вызов).
+## С флагом `-- --prof` то же печатается в консоль раз в 2 с.
+## Блоки «путь», «взгляд» и «движ» вложены в «ии» (это его части), остальные не пересекаются.
+
+const AI := 0       # Enemy._physics_process целиком (восприятие, решения, движение, move_and_slide)
+const POSE := 1     # Enemy._process: анимация скелета
+const CROWD := 2    # FarCrowd._process
+const HUD := 3      # Hud._process + отрисовка HUD (draw_hud)
+const TOUCH := 4    # сенсорные кнопки (_draw) и мини-карта
+const VEH := 5      # Vehicle._physics_process (все машины)
+const BAL := 6      # Ballistics._physics_process
+const FX := 7       # Fx._process
+const PLY := 8      # Player._process (+ оружие)
+const MAP := 9      # _process карты (вода, флаги и т. п.) и миссии
+const BB := 10      # чёрный ящик / журнал
+const NAV := 11     # (в ИИ) NavigationServer3D.map_get_path
+const SEE := 12     # (в ИИ) восприятие: лучи зрения
+const MOVE := 13    # (в ИИ) move_and_slide
+const NAMES := ["ии", "поза", "толпа", "hud", "кноп", "маш", "пули", "fx", "игрок", "карта", "журн", "путь", "взгляд", "движ"]
+
+static var verbose := "--prof" in OS.get_cmdline_user_args()
+static var _sum := PackedInt64Array()
+static var _max := PackedInt64Array()
+static var _frames := 0
+static var _pframes0 := 0
+
+
+static func _init_arrays() -> void:
+	_sum.resize(NAMES.size())
+	_max.resize(NAMES.size())
+	_sum.fill(0)
+	_max.fill(0)
+
+
+## Добавить время блока i (мкс). Вызывать как Prof.add(Prof.AI, Time.get_ticks_usec() - t0).
+static func add(i: int, us: int) -> void:
+	if _sum.is_empty():
+		_init_arrays()
+	_sum[i] += us
+	if us > _max[i]:
+		_max[i] = us
+
+
+## Кадр закончился (зовёт Blackbox._process).
+static func frame() -> void:
+	_frames += 1
+
+
+## Итог окна замера одной строкой и сброс. Среднее — мс на отрисованный кадр; «пик» — самый долгий одиночный вызов блока.
+static func report(reset := true) -> String:
+	if _sum.is_empty():
+		_init_arrays()
+	var n := maxi(1, _frames)
+	var phys := Engine.get_physics_frames() - _pframes0
+	var s := "скр мс/кадр:"
+	var total := 0.0
+	for i in NAMES.size():
+		var ms := float(_sum[i]) / n / 1000.0
+		if i < NAV:
+			total += ms
+		s += " %s=%.1f" % [NAMES[i], ms]
+	s += " всего=%.1f физ/кадр=%.1f пик:" % [total, float(phys) / n]
+	for i in NAMES.size():
+		if _max[i] >= 2000:
+			s += " %s=%.0f" % [NAMES[i], _max[i] / 1000.0]
+	if reset:
+		_sum.fill(0)
+		_max.fill(0)
+		_frames = 0
+		_pframes0 = Engine.get_physics_frames()
+	return s
